# TextBugger Environment Configuration
# Copy this file to .env and fill in your actual API credentials

# IBM Watson Natural Language Understanding
IBM_API_KEY=your_ibm_watson_api_key_here
IBM_SERVICE_URL=your_ibm_service_url_here

# Azure Text Analytics
AZURE_TEXT_ANALYTICS_KEY=your_azure_text_analytics_key_here
AZURE_TEXT_ANALYTICS_ENDPOINT=your_azure_endpoint_here

# Google Cloud NLP
# Set this to the path of your service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/google-service-account.json

# AWS Comprehend
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_DEFAULT_REGION=us-east-1

# Attack Configuration
# Number of attacks to run for API tests
NUM_ATTACKS_API=10

# Similarity threshold for semantic similarity checks (0.0 - 1.0)
SIMILARITY_THRESHOLD=0.8

# Batch configuration for query-efficient attacks
DEFAULT_BATCH_SIZE=3
CONFIDENCE_THRESHOLD_HIGH=0.75
CONFIDENCE_THRESHOLD_MEDIUM=0.6

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional: Model paths for local testing
FASTTEXT_MODEL_PATH=models/external/fasttext/amazon_review_polarity.bin
SPACY_MODEL=en_core_web_sm